<Window x:Class="Wallflow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallflow — настройки" Width="1000" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        Icon="pack://application:,,,/Assets/icon.png">
    <Window.Resources>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="14,10" Margin="0,0,0,4" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,18">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="26" Height="26" Margin="0,0,8,0"/>
                    <TextBlock Text="Wallflow" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton x:Name="NavWidgets" Style="{StaticResource Nav}" Content="🕒  Виджеты" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDesktop" Style="{StaticResource Nav}" Content="📁  Рабочий стол и папки" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTaskbar" Style="{StaticResource Nav}" Content="▭  Панель задач" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavWallpapers" Style="{StaticResource Nav}" Content="🖼  Обои" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource Nav}" Content="⚙  Общее" Checked="Nav_Checked"/>
                <Button Content="Открыть галерею обоев" Margin="0,24,0,0" Click="OpenGallery_Click"/>
                <Button x:Name="EditBtn" Content="✎ Переставить виджеты" Margin="0,8,0,0" Click="Edit_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,22,28,28">

                <!-- ============ WIDGETS ============ -->
                <StackPanel x:Name="PageWidgets">
                    <TextBlock Style="{StaticResource H}" Text="Виджеты"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <CheckBox x:Name="WClock" Content="Часы и день недели" Click="WidgetToggle_Click"/>
                                <CheckBox x:Name="WWeather" Content="Погода" Click="WidgetToggle_Click"/>
                                <CheckBox x:Name="WCalendar" Content="Календарь" Click="WidgetToggle_Click"/>
                                <CheckBox x:Name="WFolders" Content="Папки с ярлыками" Click="WidgetToggle_Click"/>
                                <CheckBox x:Name="WPlayer" Content="Плеер (что сейчас играет)" Click="WidgetToggle_Click"/>
                                <CheckBox x:Name="WTodo" Content="Список дел" Click="WidgetToggle_Click"/>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="＋ Добавить заметку" Click="AddNote_Click"/>
                                <TextBlock x:Name="NotesInfo" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" Text="СТИЛЬ ЧАСОВ (клик — применить)"/>
                    <ItemsControl x:Name="Faces">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Язык дней и месяцев:" Width="170" VerticalAlignment="Center"/>
                                <RadioButton x:Name="LangEn" Content="English (Sunday)" Margin="0,4,18,4" Click="Look_Changed"/>
                                <RadioButton x:Name="LangRu" Content="Русский (Воскресенье)" Click="Look_Changed"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <CheckBox x:Name="H24" Content="24-часовой формат" Click="Look_Changed"/>
                                <CheckBox x:Name="Seconds" Content="Показывать секунды" Click="Look_Changed"/>
                                <CheckBox x:Name="Shadow" Content="Тень под текстом" Click="Look_Changed"/>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Цвет часов:" Width="170" VerticalAlignment="Center"/>
                                <WrapPanel x:Name="ClockColors" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Градиент:" Width="170" VerticalAlignment="Center"/>
                                <CheckBox x:Name="GradOn" Content="Включить" Margin="0,4,16,4" Click="Look_Changed"/>
                                <Border x:Name="GradFrom" Width="26" Height="26" CornerRadius="13" Cursor="Hand" ToolTip="Первый цвет" MouseLeftButtonUp="GradFrom_Click"/>
                                <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center"/>
                                <Border x:Name="GradTo" Width="26" Height="26" CornerRadius="13" Cursor="Hand" ToolTip="Второй цвет" MouseLeftButtonUp="GradTo_Click"/>
                                <Border x:Name="GradPreview" Width="90" Height="18" CornerRadius="9" Margin="14,0,0,0"/>
                                <TextBlock Text="угол" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <Slider x:Name="GradAngle" Width="150" Minimum="0" Maximum="360" SmallChange="15" LargeChange="45" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Готовые градиенты:" Width="170" VerticalAlignment="Center"/>
                                <WrapPanel x:Name="GradPresets"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" Text="ПОГОДА"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Сохранить город" Margin="8,0,0,0" Click="City_Click"/>
                                <TextBox x:Name="City" ToolTip="Например: Tashkent, Ташкент, Moscow"/>
                            </DockPanel>
                            <TextBlock x:Name="CityStatus" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="12"
                                       Text="Данные: Open-Meteo (бесплатно, без ключа). Обновление раз в 30 минут."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" Text="СТЕКЛО ВИДЖЕТОВ И ПАПОК"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ModeFrost" Content="Матовое стекло (размытые обои, как на iPhone)" Margin="0,4,18,4" Click="Look_Changed"/>
                                <RadioButton x:Name="ModeTint" Content="Тонировка" Margin="0,4,18,4" Click="Look_Changed"/>
                                <RadioButton x:Name="ModeClear" Content="Только контур" Click="Look_Changed"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <RadioButton x:Name="TintDark" Content="Тёмный оттенок" Margin="0,4,18,4" Click="Look_Changed"/>
                                <RadioButton x:Name="TintLight" Content="Светлый оттенок" Click="Look_Changed"/>
                            </WrapPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Размытие" Width="170" VerticalAlignment="Center"/>
                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Slider_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Затемнение / осветление" Width="170" VerticalAlignment="Center"/>
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="0.85" SmallChange="0.05" LargeChange="0.1" ValueChanged="Slider_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Скругление углов" Width="170" VerticalAlignment="Center"/>
                                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="40" SmallChange="2" LargeChange="4" ValueChanged="Slider_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Размер виджетов" Width="170" VerticalAlignment="Center"/>
                                <Slider x:Name="ScaleSlider" Minimum="0.6" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" ValueChanged="Slider_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Вернуть виджеты на места по умолчанию" HorizontalAlignment="Left" Click="ResetPos_Click"/>
                </StackPanel>

                <!-- ============ DESKTOP ============ -->
                <StackPanel x:Name="PageDesktop" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H}" Text="Рабочий стол и папки"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="HideIcons" Content="Скрыть обычные значки рабочего стола (останутся только виджеты и папки)" Click="HideIcons_Click"/>
                            <CheckBox x:Name="AutoAdd" Content="Новые ярлыки на рабочем столе сами попадают в подходящую папку" Click="AutoAdd_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Открывать папки:" Width="140" VerticalAlignment="Center"/>
                                <RadioButton x:Name="OpenClick" Content="кликом" Margin="0,4,18,4" Click="OpenMode_Click"/>
                                <RadioButton x:Name="OpenHover" Content="при наведении" Click="OpenMode_Click"/>
                            </StackPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Разложить всё по папкам заново" Margin="0,0,8,0" Click="Rearrange_Click"/>
                                <Button Content="Новая папка" Click="NewFolder_Click"/>
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Файлы ярлыков никуда не перемещаются и не удаляются — папки только показывают их красиво. При выходе из Wallflow обычные значки возвращаются. Ещё можно перетащить любой файл прямо на папку-виджет."/>
                        </StackPanel>
                    </Border>

                    <Grid Height="430">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="4,8,0,0">
                                    <Button Content="↑" Padding="10,4" Margin="0,0,4,0" Click="FolderUp_Click" ToolTip="Выше"/>
                                    <Button Content="↓" Padding="10,4" Margin="0,0,4,0" Click="FolderDown_Click" ToolTip="Ниже"/>
                                    <Button Content="Переименовать" Padding="10,4" Margin="0,0,4,0" Click="RenameFolder_Click"/>
                                    <Button Content="🗑" Padding="10,4" Click="DeleteFolder_Click" ToolTip="Удалить папку (ярлыки уйдут в «Другое»)"/>
                                </WrapPanel>
                                <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                                         SelectionChanged="FolderList_SelectionChanged"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="4,8,0,0">
                                    <TextBlock Text="Переместить выбранные в:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button DockPanel.Dock="Right" Content="Убрать" Margin="8,0,0,0" Click="RemoveItems_Click" ToolTip="Убрать из папок (файл останется)"/>
                                    <Button DockPanel.Dock="Right" Content="OK" Margin="8,0,0,0" Click="MoveItems_Click"/>
                                    <ComboBox x:Name="MoveTarget"/>
                                </DockPanel>
                                <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                                         SelectionMode="Extended"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ============ TASKBAR ============ -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H}" Text="Панель задач"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="DockOn" Content="Стеклянный док вместо панели задач" FontSize="15" FontWeight="SemiBold" Click="Dock_Changed"/>
                            <TextBlock Margin="26,2,0,8" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Внизу экрана появляется стеклянная панель: Пуск, поиск, закреплённые программы (берутся с твоей панели задач), открытые окна и часы. Обычная панель прячется и выезжает, если подвести мышь к самому краю экрана — там же значки трея."/>
                            <UniformGrid Columns="2" Margin="26,0,0,0">
                                <CheckBox x:Name="DockAutoHide" Content="Прятать обычную панель задач" Click="Dock_Changed"/>
                                <CheckBox x:Name="DockReserve" Content="Окна не заходят под док" Click="Dock_Changed"/>
                                <CheckBox x:Name="DockStart" Content="Кнопка «Пуск»" Click="Dock_Changed"/>
                                <CheckBox x:Name="DockSearch" Content="Кнопка поиска" Click="Dock_Changed"/>
                                <CheckBox x:Name="DockRunning" Content="Открытые программы" Click="Dock_Changed"/>
                                <CheckBox x:Name="DockClock" Content="Часы и дата" Click="Dock_Changed"/>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="26,10,0,0">
                                <TextBlock Text="Размер значков" Width="150" VerticalAlignment="Center"/>
                                <Slider x:Name="DockSize" Width="260" Minimum="28" Maximum="64" SmallChange="2" LargeChange="4" ValueChanged="DockSize_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="26,10,0,0">
                                <Button Content="Заново взять закреплённые с панели задач" Click="DockReimport_Click"/>
                            </StackPanel>
                            <TextBlock Margin="26,8,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Правый клик по значку в доке: закрепить/открепить, открыть ещё окно, закрыть. Клик по открытой программе сворачивает/разворачивает её. Стекло дока берёт настройки из раздела «Виджеты». В полноэкранных играх док прячется сам."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" Text="ОБЫЧНАЯ ПАНЕЛЬ WINDOWS"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Поиск" Width="200" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TbSearch" Width="260" SelectionChanged="Taskbar_Changed">
                                    <ComboBoxItem Tag="-1" Content="не трогать"/>
                                    <ComboBoxItem Tag="0" Content="скрыть"/>
                                    <ComboBoxItem Tag="1" Content="только значок"/>
                                    <ComboBoxItem Tag="3" Content="значок и надпись"/>
                                    <ComboBoxItem Tag="2" Content="поле поиска"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Представление задач" Width="200" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TbTaskView" Width="260" SelectionChanged="Taskbar_Changed">
                                    <ComboBoxItem Tag="-1" Content="не трогать"/>
                                    <ComboBoxItem Tag="0" Content="скрыть"/>
                                    <ComboBoxItem Tag="1" Content="показать"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Виджеты Windows (погода слева)" Width="200" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TbWidgets" Width="260" SelectionChanged="Taskbar_Changed">
                                    <ComboBoxItem Tag="-1" Content="не трогать"/>
                                    <ComboBoxItem Tag="0" Content="скрыть"/>
                                    <ComboBoxItem Tag="1" Content="показать"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Значки" Width="200" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TbAlign" Width="260" SelectionChanged="Taskbar_Changed">
                                    <ComboBoxItem Tag="-1" Content="не трогать"/>
                                    <ComboBoxItem Tag="1" Content="по центру"/>
                                    <ComboBoxItem Tag="0" Content="слева"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="TbStatus" Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Меняются сразу. Закреплённые программы остаются как были."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ WALLPAPERS ============ -->
                <StackPanel x:Name="PageWallpapers" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H}" Text="Обои"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Как размещать картинку" Margin="0,0,0,6"/>
                            <ComboBox x:Name="WpStyle" SelectionChanged="WpStyle_Changed">
                                <ComboBoxItem Tag="fill" Content="Заполнение"/>
                                <ComboBoxItem Tag="fit" Content="По размеру"/>
                                <ComboBoxItem Tag="stretch" Content="Растянуть"/>
                                <ComboBoxItem Tag="center" Content="По центру"/>
                                <ComboBoxItem Tag="tile" Content="Замостить"/>
                                <ComboBoxItem Tag="span" Content="Расширение (на несколько мониторов)"/>
                            </ComboBox>
                            <TextBlock Text="Папка для скачанных обоев" Margin="0,14,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Открыть" Margin="6,0,0,0" Click="OpenDir_Click"/>
                                <Button DockPanel.Dock="Right" Content="Выбрать…" Margin="6,0,0,0" Click="PickDir_Click"/>
                                <TextBox x:Name="SaveDir" IsReadOnly="True"/>
                            </DockPanel>
                            <TextBlock Text="Ключ API Wallhaven (необязательно)" Margin="0,14,0,6"/>
                            <TextBox x:Name="ApiKey" LostFocus="ApiKey_LostFocus" ToolTip="wallhaven.cc → Settings → Account → API Key"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Sub}" Text="СЛАЙДШОУ — АВТОСМЕНА ОБОЕВ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SsOn" Content="Включить" Click="Slideshow_Changed"/>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="Каждые" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SsMin" Width="70" LostFocus="Slideshow_Changed"/>
                                <TextBlock Text="минут, источник:" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <ComboBox x:Name="SsSrc" Width="300" SelectionChanged="Slideshow_Changed">
                                    <ComboBoxItem Tag="favorites" Content="Избранное"/>
                                    <ComboBoxItem Tag="search" Content="Wallhaven с последними фильтрами"/>
                                    <ComboBoxItem Tag="bing" Content="Bing — обои дня"/>
                                </ComboBox>
                            </WrapPanel>
                            <Button Content="Сменить сейчас" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Next_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ GENERAL ============ -->
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H}" Text="Общее"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoStart" Content="Запускать вместе с Windows (сразу в трей)" Click="AutoStart_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Sub}" Text="ПОТРЕБЛЕНИЕ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="MemInfo" TextWrapping="Wrap"/>
                            <Button Content="Освободить память сейчас" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Trim_Click"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Wallflow — один нативный процесс без браузерного движка. Галерея и это окно создаются только когда открыты и полностью выгружаются после закрытия. Часы просыпаются раз в минуту, погода — раз в 30 минут, календарь — в полночь. В фоне процессор ≈ 0%."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="Шрифты: Bebas Neue, Great Vibes, Orbitron, Unbounded, Monoton, Major Mono Display, Comfortaa, Poiret One — SIL Open Font License. Обои: Wallhaven, Bing. Погода: Open-Meteo."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

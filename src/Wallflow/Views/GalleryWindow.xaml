<Window x:Class="Wallflow.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallflow — обои" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        Icon="pack://application:,,,/Assets/icon.png">
    <Window.Resources>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="14,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="26" Height="26" Margin="0,0,8,0"/>
                    <TextBlock Text="Wallflow" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <RadioButton x:Name="TabBrowse" Style="{StaticResource Tab}" Content="Обзор" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabBing" Style="{StaticResource Tab}" Content="Bing дня" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFav" Style="{StaticResource Tab}" Checked="Tab_Checked">
                        <TextBlock><Run Text="Избранное "/><Run x:Name="FavCount" Foreground="{StaticResource Accent2}"/></TextBlock>
                    </RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBox x:Name="Query" Width="380" KeyDown="Query_KeyDown" ToolTip="Слова, #тег, like:id (похожие)"/>
                    <Button Content="Найти" Margin="6,0,0,0" Click="Apply_Click" Style="{StaticResource Primary}"/>
                    <Button Content="⚙" Margin="10,0,0,0" ToolTip="Настройки" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- filters -->
            <Border x:Name="FiltersPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,20">
                        <TextBlock Style="{StaticResource H}" Text="РАЗРЕШЕНИЕ"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="ModeAtLeast" Content="Не меньше" IsChecked="True" Margin="0,4,16,4" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeExact" Content="Точно" Checked="Mode_Checked"/>
                        </StackPanel>
                        <WrapPanel x:Name="ResChips"/>
                        <Button Content="⌖ Под мой экран" HorizontalAlignment="Left" Margin="0,4,0,0" Click="MyScreen_Click"/>

                        <TextBlock Style="{StaticResource H}" Text="СООТНОШЕНИЕ СТОРОН"/>
                        <WrapPanel x:Name="RatioChips"/>

                        <TextBlock Style="{StaticResource H}" Text="ЦВЕТ"/>
                        <WrapPanel x:Name="ColorChips"/>

                        <TextBlock Style="{StaticResource H}" Text="ТЕМЫ"/>
                        <WrapPanel x:Name="TopicChips"/>

                        <TextBlock Style="{StaticResource H}" Text="КАТЕГОРИИ"/>
                        <CheckBox x:Name="CatGeneral" Content="Общие" IsChecked="True"/>
                        <CheckBox x:Name="CatAnime" Content="Аниме" IsChecked="True"/>
                        <CheckBox x:Name="CatPeople" Content="Люди" IsChecked="True"/>

                        <TextBlock Style="{StaticResource H}" Text="СОРТИРОВКА"/>
                        <ComboBox x:Name="Sorting" SelectionChanged="Sorting_Changed">
                            <ComboBoxItem Tag="toplist" Content="Топ" IsSelected="True"/>
                            <ComboBoxItem Tag="date_added" Content="Новые"/>
                            <ComboBoxItem Tag="hot" Content="Популярные сейчас"/>
                            <ComboBoxItem Tag="views" Content="Просмотры"/>
                            <ComboBoxItem Tag="favorites" Content="Больше всего в избранном"/>
                            <ComboBoxItem Tag="relevance" Content="Релевантность"/>
                            <ComboBoxItem Tag="random" Content="Случайно"/>
                        </ComboBox>
                        <ComboBox x:Name="TopRange" Margin="0,6,0,0">
                            <ComboBoxItem Tag="1d" Content="за день"/>
                            <ComboBoxItem Tag="3d" Content="за 3 дня"/>
                            <ComboBoxItem Tag="1w" Content="за неделю"/>
                            <ComboBoxItem Tag="1M" Content="за месяц" IsSelected="True"/>
                            <ComboBoxItem Tag="3M" Content="за 3 месяца"/>
                            <ComboBoxItem Tag="6M" Content="за полгода"/>
                            <ComboBoxItem Tag="1y" Content="за год"/>
                        </ComboBox>

                        <UniformGrid Columns="2" Margin="0,18,0,0">
                            <Button Content="Применить" Style="{StaticResource Primary}" Margin="0,0,4,0" Click="Apply_Click"/>
                            <Button Content="Сбросить" Margin="4,0,0,0" Click="Reset_Click"/>
                        </UniformGrid>
                        <TextBlock Margin="0,20,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Обои не хранятся в приложении — они загружаются из Wallhaven и Bing по API."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- results -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Status" Margin="20,12,20,6" Foreground="{StaticResource Muted}"/>
                <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroller_ScrollChanged">
                    <ItemsControl x:Name="Cards" Margin="14,0,14,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- preview -->
        <Grid x:Name="Preview" Grid.RowSpan="2" Visibility="Collapsed" Background="#E6050610" MouseLeftButtonDown="PreviewBg_Click">
            <Border Margin="40" CornerRadius="14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    ClipToBounds="True" MouseLeftButtonDown="PreviewBody_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>
                    <Grid Background="Black">
                        <Image x:Name="PImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PLoading" Text="Загрузка…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="10,4" Click="ClosePreview_Click"/>
                                <TextBlock x:Name="PTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="PMeta" Margin="0,10,0,10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20"/>
                            <WrapPanel x:Name="PColors" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="PTags" Margin="0,0,0,10"/>
                            <Button x:Name="PSet" Content="🖥  Установить на рабочий стол" Style="{StaticResource Primary}" Margin="0,0,0,8" Click="PSet_Click"/>
                            <Button x:Name="PFav" Content="☆  В избранное" Margin="0,0,0,8" Click="PFav_Click"/>
                            <Button x:Name="PDownload" Content="⬇  Скачать" Margin="0,0,0,8" Click="PDownload_Click"/>
                            <Button x:Name="PSimilar" Content="≈  Похожие" Margin="0,0,0,8" Click="PSimilar_Click"/>
                            <Button Content="Открыть источник ↗" Click="POpen_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- toast -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                Padding="18,10" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"/>
        </Border>
    </Grid>
</Window>

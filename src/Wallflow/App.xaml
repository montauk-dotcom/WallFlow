<Application x:Class="Wallflow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Bg" Color="#0D0F17"/>
            <SolidColorBrush x:Key="Panel" Color="#141724"/>
            <SolidColorBrush x:Key="Panel2" Color="#1B1F30"/>
            <SolidColorBrush x:Key="Line" Color="#262B40"/>
            <SolidColorBrush x:Key="Fg" Color="#E7E9F3"/>
            <SolidColorBrush x:Key="Muted" Color="#8A90A8"/>
            <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
            <SolidColorBrush x:Key="Accent2" Color="#A08BFF"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            </Style>

            <Style x:Key="BaseButton" TargetType="ButtonBase">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Panel2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}"/>
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Padding" Value="9,4"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Panel2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="Padding" Value="0,10,0,4"/>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
